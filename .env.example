# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key (NEVER expose to clients). Server-only.
# Required for admin server actions to bypass RLS when running in
# dev-admin mode. Copy from Supabase Dashboard → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Local dev admin bypass — OPT-IN, and ignored in production builds.
#
# Set to "true" to sign in at /admin/login with admin@dentaris.mn /
# dentaris2026 without a Supabase user. The session cookie is HMAC-signed, so
# a signing secret must also be available (DEV_ADMIN_COOKIE_SECRET, or
# SUPABASE_SERVICE_ROLE_KEY as a fallback) — otherwise the bypass stays off.
#
# Never set this on a deployed environment: these credentials are public.
ALLOW_DEV_ADMIN=
# Optional dedicated secret for signing dev-session cookies. Any long random
# string. Falls back to SUPABASE_SERVICE_ROLE_KEY when unset.
DEV_ADMIN_COOKIE_SECRET=

# ---------------------------------------------------------------------------
# QPay webhook shared token. QPay has no request signature, so the callback
# URL carries this token and /api/qpay/callback rejects requests without it.
# Any long random string. Leave blank to keep the endpoint open (it still
# verifies every payment against QPay before creating a booking).
QPAY_CALLBACK_TOKEN=

# Dentexgo integration
# Mirrors the `clinics.slug` value on Dentexgo's side. Used as the path
# segment in the outbound webhook URL.
CLINIC_SLUG=dentaris

# 256-bit random secret shared with Dentexgo. Dentexgo generates it at
# onboard, encrypts it, and stores it in `clinics.api_secret_encrypted`.
# Paste the plaintext value here.
DENTEXGO_SHARED_SECRET=

# Where to POST sync webhooks. Dentexgo dev runs on :3000; this site on :3001.
# Override with an ngrok URL when testing against a remote Dentexgo.
DENTEXGO_WEBHOOK_BASE_URL=http://localhost:3000

# Base URL for outbound calls FROM this admin TO Dentexgo's public API
# (FAQ management, insights, bot persona). Defaults to https://dentexgo.mn.
# Use http://localhost:3000 against a local Dentexgo dev server.
DENTEXGO_API_BASE_URL=https://dentexgo.mn

# Public origin of this site. Used to build `bookingUrl` in API responses.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Cloudinary — image hosting for service / doctor photos uploaded via /api/upload.
# Cloud name is public (used to build public delivery URLs).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Unsigned upload preset name. Create in Cloudinary dashboard → Settings →
# Upload → Add upload preset → Signing Mode: Unsigned. Server-only.
CLOUDINARY_UPLOAD_PRESET=
# Optional: store uploaded assets under a subfolder, e.g. "dentaris/services".
# Leave blank to upload to the cloud's root.
CLOUDINARY_UPLOAD_FOLDER=dentaris
